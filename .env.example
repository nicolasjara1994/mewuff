# =============================================================================
# MeWuff Studio · Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# =============================================================================

# --- Público (se incluye en el bundle del navegador) -------------------------
# URL canónica del sitio (sin "/" final). Se usa para SEO, sitemap y validación de origen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Servidor (SECRETO: nunca usar el prefijo NEXT_PUBLIC_) -------------------
# Si se dejan vacías en desarrollo, las solicitudes se guardan en ./.local-data
# En producción son OBLIGATORIAS.
SUPABASE_URL=
# Clave "service_role" (o la nueva "secret key" sb_secret_...). Ignora RLS:
# solo se usa en el servidor de Next.js.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado para las fotos (lo crea la migración SQL).
SUPABASE_STORAGE_BUCKET=pet-photos

# Salt para anonimizar IPs en el rate limiting. Genera uno aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# --- IA (opcional, aún no implementada) ---------------------------------------
# "none" o vacío = desactivada. El flujo principal no depende de la IA.
AI_PROVIDER=none
